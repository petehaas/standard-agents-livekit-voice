# Copy to .dev.vars and fill in. .dev.vars is ignored by git.
#
# Local session and data encryption: exactly 32 characters, e.g. `openssl rand -hex 16`
ENCRYPTION_KEY=

# Lets you sign in to the local admin UI without a platform account (user "admin").
SUPER_ADMIN_PASSWORD=

# OpenAI: the reply model, and speech too unless you choose Deepgram or ElevenLabs.
OPENAI_API_KEY=

# Optional: a Standard Agents platform key, if you use the platform.
# STANDARD_AGENTS_API_KEY=

# Speech keys. The voice handler reads these through state.env(), which does
# not see this file; `npm start` in host/ copies them into the runtime as
# instance variables. See "Choosing speech providers" in the README.
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
