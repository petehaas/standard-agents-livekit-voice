{
  "name": "livekit-support-desk-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The demo support desk: runs @petehaas/standard-agents-livekit-host for the voice_concierge agent and serves the caller page.",
  "scripts": {
    "prestart": "tsx src/sync-keys.ts",
    "start": "tsx src/index.ts",
    "probe": "tsx src/probe.ts",
    "sync-keys": "tsx src/sync-keys.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-force-exit test/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.0",
    "livekit-client": "2.16.1",
    "@petehaas/standard-agents-livekit-host": "^0.1.0",
    "@petehaas/standard-agents-livekit-voice": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.0"
  }
}
