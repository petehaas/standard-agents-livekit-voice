{
  "name": "standard-agents-livekit-voice",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/voice",
    "packages/host",
    "agent",
    "host"
  ],
  "scripts": {
    "dev": "npm run dev -w agent",
    "start": "npm start -w host",
    "probe": "npm run probe -w host",
    "build": "npm run build -w @petehaas/standard-agents-livekit-voice && npm run build -w @petehaas/standard-agents-livekit-host",
    "postinstall": "npm run build",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present"
  }
}
