# Copy to .dev.vars and fill in. .dev.vars is ignored by git.
#
# The fastest path: copy the .dev.vars that `npx @standardagents/cli@latest create`
# wrote for your account (it holds ENCRYPTION_KEY and STANDARD_AGENTS_API_KEY).

# Local session and data encryption: exactly 32 characters, e.g. `openssl rand -hex 16`
ENCRYPTION_KEY=

# Lets you sign in to the local admin UI without a platform account (user "admin").
# SUPER_ADMIN_PASSWORD=

# Standard Agents platform key: covers the reply model through the platform.
STANDARD_AGENTS_API_KEY=

# Or skip the platform key and use your own OpenAI key for the reply model.
# OPENAI_API_KEY=

# Note: the voice handler reads its STT/TTS keys through state.env(), which
# resolves thread, agent, user, and instance variables, not this file. Set
# OPENAI_API_KEY (or DEEPGRAM_API_KEY / ELEVENLABS_API_KEY) as an instance
# variable in the admin UI. See the README.
