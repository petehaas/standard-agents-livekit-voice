# Copy to .env and fill in. .env is ignored by git.

# ── Standard Agents Builder ─────────────────────────────────
# The agent's dev server (run `npm run dev` in ../agent).
SA_BASE_URL=http://127.0.0.1:5173
# The SUPER_ADMIN_PASSWORD from agent/.dev.vars. The host signs in as "admin".
SA_ADMIN_PASSWORD=
# Or an API key instead (agtbldr_… or sak_live_…).
# SA_API_KEY=
SA_AGENT=voice_concierge

# Optional per-call provider choices, passed as thread env (no keys here).
# VOICE_STT_PROVIDER=openai      # openai | deepgram
# VOICE_TTS_PROVIDER=openai      # openai | elevenlabs
# OPENAI_TTS_VOICE=coral

# ── LiveKit ─────────────────────────────────────────────────
# From your LiveKit Cloud project settings (wss://<project>.livekit.cloud).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# LIVEKIT_ROOM=sa-voice-demo

# ── Turn taking (optional) ──────────────────────────────────
# VAD_MARGIN_DB=12          # speech must be this far above the noise floor
# VAD_MIN_SPEECH_DB=-48     # lower it for soft-spoken callers
# TURN_MIN_SPEECH_MS=160
# TURN_PREROLL_MS=300
# BARGE_IN=on               # off for speakerphones without echo cancellation
# BARGE_IN_MS=240
